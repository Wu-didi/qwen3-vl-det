{
  "model_path": "./model_cache/Qwen/Qwen3-VL-4B-Instruct",
  "use_4bit": true,
  "use_8bit": false,
  "lora_r": 64,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "train_data": "data/hefei_last_dataset/sft_output/train.jsonl",
  "val_data": "data/hefei_last_dataset/sft_output/val.jsonl",
  "max_length": 2048,
  "max_image_size": 1024,
  "output_dir": "outputs/qwen3vl4b_lora",
  "num_epochs": 3,
  "batch_size": 2,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0002,
  "warmup_ratio": 0.1,
  "weight_decay": 0.01,
  "logging_steps": 10,
  "save_steps": 500,
  "eval_steps": 500,
  "seed": 42,
  "bf16": true,
  "gradient_checkpointing": true
}